[MAIN]
# Default fail-under is 10. This repository has never met that bar.
# The threshold matches the score after the disables below; raise it
# when the remaining warnings are cleaned up.
fail-under=9.4

[MESSAGES CONTROL]
# Historical style only. Import errors and other warnings still fail the run.
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    consider-using-f-string,
    useless-object-inheritance,
    logging-format-interpolation,

[FORMAT]
max-line-length=100
